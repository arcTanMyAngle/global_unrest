# Build artifacts
/target/

# Secrets — credentials live in env vars or .env files, never in git
.env
.env.*
# ...except the committed template (contains no secrets)
!.env.example

# Local databases and data directories
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite-journal
*.db
*.db-journal
/var/
/data/

# Telegram MTProto session (source-telegram) — holds a live login, treat it
# like a credential. Covers SQLite's own -journal/-wal/-shm sidecar files.
*.session
*.session-*

# Editor noise
.vscode/
.idea/
