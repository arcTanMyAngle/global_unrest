# Copy to `.env` (gitignored) and fill in. The desktop loads this file at
# startup; process environment variables still take precedence.

# ACLED (M5, feature `acled-live`): free myACLED account, https://acleddata.com
# OAuth password grant — ACLED retired API keys; there is no ACLED_API_KEY.
ACLED_EMAIL=
ACLED_PASSWORD=

# Optional inclusive historical window for date-restricted ACLED accounts.
# LES_ACLED_WINDOW=2025-06-01|2025-06-30

# IODA (internet-outage events, feature `ioda-live`) is keyless — no
# credentials needed. LES_IODA_ENDPOINT exists only to point the adapter at
# a local/mock server for testing.
