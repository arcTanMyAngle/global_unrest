# Copy this file to .env and fill in only the credentials you need.
# The desktop loads .env at startup; process environment variables take
# precedence. Do not commit .env, session files, or API keys.

# ACLED: an authorized myACLED account. ACLED uses OAuth credentials, not an
# API key.
ACLED_EMAIL=
ACLED_PASSWORD=

# Optional inclusive historical window for date-restricted ACLED accounts.
# LES_ACLED_WINDOW=2025-06-01|2025-06-30

# Telegram aggregate chatter: credentials for a dedicated account's MTProto
# app, not a bot token. Run the one-time login setup documented in README.md
# to create the local session file.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
LES_TELEGRAM_SESSION_FILE=./telegram.session

# Daily Events: optional Gemini-backed digest generation. The desktop makes
# no request until Generate digest is clicked for a selected UTC day.
GEMINI_API_KEY=

# Test-only endpoint override for the Daily Events mock-server suite.
# LES_GEMINI_ENDPOINT=http://127.0.0.1:12345

# IODA, Bluesky, and NOAA/NWS are keyless. Their endpoint overrides are for
# local/mock testing only:
# LES_IODA_ENDPOINT=
# LES_BLUESKY_ENDPOINT=
# LES_NOAA_ENDPOINT=
