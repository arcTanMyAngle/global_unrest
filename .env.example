# Copy to `.env` (gitignored) and fill in. The desktop loads this file at
# startup; process environment variables still take precedence.

# ACLED (M5, feature `acled-live`): free myACLED account, https://acleddata.com
# OAuth password grant — ACLED retired API keys; there is no ACLED_API_KEY.
ACLED_EMAIL=
ACLED_PASSWORD=

# Optional inclusive historical window for date-restricted ACLED accounts.
# LES_ACLED_WINDOW=2025-06-01|2025-06-30

# IODA (internet-outage events, feature `ioda-live`) is keyless — no
# credentials needed. LES_IODA_ENDPOINT exists only to point the adapter at
# a local/mock server for testing.

# Bluesky Jetstream (feature `bluesky-live`) is keyless — no credentials
# needed. LES_BLUESKY_ENDPOINT exists only to point the client at a
# local/mock server for testing.

# Telegram (aggregate chatter, feature `telegram-live`): dedicated/throwaway
# account's MTProto app credentials from https://my.telegram.org, NOT a bot
# token (bots can't read channels they weren't added to). Read-only —
# never posts, never joins a channel it doesn't already have public access
# to.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Local JSON session file (gitignored — treat it like a credential, it
# holds a live login). Created once by:
#   cargo run -p source-telegram --features live --example login_setup
# The real source only ever opens this file; it never logs in itself.
LES_TELEGRAM_SESSION_FILE=./telegram.session

# Daily Events digest (desktop-only, feature `gemini-live`): a Google AI
# Studio key, https://aistudio.google.com/apikey. Optional — without it the
# page still reads every previously generated digest and makes no requests.
# NOTE: Google's free tier may use submitted prompts and responses to improve
# their products, and human reviewers may read them. Only public metadata and
# our own derived counts are ever sent — see docs/SAFETY_AND_PRIVACY.md,
# "Third-party processing".
GEMINI_API_KEY=
